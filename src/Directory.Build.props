<Project>

  <!--
    WinUI 3 / MrtCore PRI generation needs the AppxPackage MSBuild tasks that ship with
    Visual Studio. When the project is built with the plain .NET SDK (dotnet build) instead of
    Visual Studio, MSBuild looks for them under its own "v18.0" folder, which does not exist,
    and the build fails with MSB4062 (Microsoft.Build.Packaging.Pri.Tasks.dll not found).

    This file points the build at a Visual Studio copy when one can be found, so the project can
    be compiled from the command line. It is a no-op on machines without Visual Studio, where you
    would normally build inside the IDE anyway.
  -->
  <PropertyGroup Condition="'$(AppxMSBuildToolsPath)' == ''">
    <_VsAppxPackagePath Condition="'$(VSINSTALLDIR)' != '' And Exists('$(VSINSTALLDIR)MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\Microsoft.Build.Packaging.Pri.Tasks.dll')">$(VSINSTALLDIR)MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\</_VsAppxPackagePath>

    <_VsAppxPackagePath Condition="'$(_VsAppxPackagePath)' == '' And Exists('C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\Microsoft.Build.Packaging.Pri.Tasks.dll')">C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\</_VsAppxPackagePath>
    <_VsAppxPackagePath Condition="'$(_VsAppxPackagePath)' == '' And Exists('C:\Program Files (x86)\Microsoft Visual Studio\2022\Community\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\Microsoft.Build.Packaging.Pri.Tasks.dll')">C:\Program Files (x86)\Microsoft Visual Studio\2022\Community\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\</_VsAppxPackagePath>
    <_VsAppxPackagePath Condition="'$(_VsAppxPackagePath)' == '' And Exists('C:\Program Files (x86)\Microsoft Visual Studio\2022\Professional\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\Microsoft.Build.Packaging.Pri.Tasks.dll')">C:\Program Files (x86)\Microsoft Visual Studio\2022\Professional\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\</_VsAppxPackagePath>
    <_VsAppxPackagePath Condition="'$(_VsAppxPackagePath)' == '' And Exists('C:\Program Files (x86)\Microsoft Visual Studio\2022\Enterprise\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\Microsoft.Build.Packaging.Pri.Tasks.dll')">C:\Program Files (x86)\Microsoft Visual Studio\2022\Enterprise\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\</_VsAppxPackagePath>

    <_VsAppxPackagePath Condition="'$(_VsAppxPackagePath)' == '' And Exists('C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\Microsoft.Build.Packaging.Pri.Tasks.dll')">C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\</_VsAppxPackagePath>
    <_VsAppxPackagePath Condition="'$(_VsAppxPackagePath)' == '' And Exists('C:\Program Files\Microsoft Visual Studio\2022\Professional\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\Microsoft.Build.Packaging.Pri.Tasks.dll')">C:\Program Files\Microsoft Visual Studio\2022\Professional\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\</_VsAppxPackagePath>
    <_VsAppxPackagePath Condition="'$(_VsAppxPackagePath)' == '' And Exists('C:\Program Files\Microsoft Visual Studio\2022\Enterprise\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\Microsoft.Build.Packaging.Pri.Tasks.dll')">C:\Program Files\Microsoft Visual Studio\2022\Enterprise\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\</_VsAppxPackagePath>

    <AppxMSBuildToolsPath Condition="'$(_VsAppxPackagePath)' != ''">$(_VsAppxPackagePath)</AppxMSBuildToolsPath>
  </PropertyGroup>

</Project>
