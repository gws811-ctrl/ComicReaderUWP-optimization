<base:BaseContentDialog
    x:Class="ComicReaderUWP.Views.Dialogs.ChooseLocation.ChooseLocationsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReaderUWP.Common.BaseUI"
    xmlns:converters="using:ComicReaderUWP.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ComicReaderUWP.ViewModels"
    x:Uid="ChooseLocationDialog"
    PrimaryButtonClick="ContentDialogPrimaryButtonClick"
    PrimaryButtonText="{x:Bind StringResource.Done}"
    mc:Ignorable="d">

    <base:BaseContentDialog.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ListViewItem.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Normal Template  -->
            <DataTemplate x:Key="NormalTemplate" x:DataType="vm:FolderItemViewModel">
                <Grid
                    x:Uid="RemoveLocationButton"
                    Padding="20,10"
                    Background="{ThemeResource SystemAccentColor}"
                    PointerPressed="RemoveFolderPointerPressed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Text="{x:Bind Folder}"
                        TextWrapping="Wrap" />
                    <FontIcon
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        FontSize="14"
                        Foreground="White"
                        Glyph="&#xE894;" />
                </Grid>
            </DataTemplate>

            <!--  Add New Template  -->
            <DataTemplate x:Key="AddNewTemplate" x:DataType="vm:FolderItemViewModel">
                <Grid
                    Background="{ThemeResource SystemAccentColor}"
                    PointerPressed="AddNewPointerPressed"
                    ToolTipService.ToolTip="{x:Bind StringResource.AddFolder}">
                    <FontIcon Foreground="White" Glyph="&#xE710;" />
                </Grid>
            </DataTemplate>

            <!--  Template Selectors  -->
            <converters:FolderItemTemplateSelector
                x:Key="FolderItemTemplateSelector"
                AddNewTemplate="{StaticResource AddNewTemplate}"
                NormalTemplate="{StaticResource NormalTemplate}" />

        </ResourceDictionary>
    </base:BaseContentDialog.Resources>

    <!--
        The folder list used to sit inside a StackPanel, which measures children with infinite
        height. The ListView therefore never realised it was taller than the dialog: no scrollbar,
        no wheel scrolling, and folders beyond the visible area were unreachable once more than a
        handful of paths were added. Using a Grid with a star-sized row gives the ListView a bounded
        height so its built-in ScrollViewer works.
    -->
    <Grid MaxHeight="520">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Uid="WatchingFolders" />
        <Grid Grid.Row="1" Height="10" />
        <ListView
            Grid.Row="2"
            ItemTemplateSelector="{StaticResource FolderItemTemplateSelector}"
            ItemsSource="{x:Bind FolderItemDataSource}"
            Loaded="ListViewLoaded"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.HorizontalScrollMode="Disabled"
            ScrollViewer.IsDeferredScrollingEnabled="False"
            ScrollViewer.IsVerticalRailEnabled="True"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollMode="Enabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,10,0,0" />
                    <Setter Property="MinHeight" Value="70" />
                    <Setter Property="Width" Value="350" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</base:BaseContentDialog>